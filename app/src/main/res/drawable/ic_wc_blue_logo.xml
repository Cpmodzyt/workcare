<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Solid Pitch Black Background Squircle -->
    <path
        android:fillColor="#000000"
        android:pathData="M 38,12 L 70,12 A 26,26 0 0 1 96,38 L 96,70 A 26,26 0 0 1 70,96 L 38,96 A 26,26 0 0 1 12,70 L 12,38 A 26,26 0 0 1 38,12 Z" />

    <!-- Google-G Style Minimalist 'C' (Care) Open Circle (Blue-to-Cyan Gradient) -->
    <path
        android:strokeWidth="10"
        android:strokeLineCap="round"
        android:pathData="M 76,32 A 28,28 0 1,0 76,76">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="26"
                android:startY="82"
                android:endX="82"
                android:endY="26"
                android:type="linear">
                <item android:offset="0.0" android:color="#2563EB" /> <!-- Blue-600 -->
                <item android:offset="1.0" android:color="#06B6D4" /> <!-- Cyan-500 -->
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sleek, Sharp Chevron 'W' (Work) in Premium White -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="10"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M 40,44 L 54,60 L 68,44" />

</vector>
